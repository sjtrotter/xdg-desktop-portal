<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <!--
      org.freedesktop.impl.portal.experimental.WebAuthentication1:
      @short_description: Backend for the web sign-in portal

      The backend owns the web view and its window. It checks every navigation
      in every frame for a match against the completion URI. A match ends the
      flow and returns the matched URI. Matching navigations must never be
      loaded in any frame.

      The frontend validates requests and clamps ``timeout``. Backends must
      honour ``session_mode`` and fail if ``ephemeral`` storage is requested
      but unavailable.

      This is an experimental interface and can change or get removed at
      any time. An incompatible change increments the number at the end of
      the interface name. See :doc:`experimental-portals`.
  -->
  <interface name="org.freedesktop.impl.portal.experimental.WebAuthentication1">
    <!--
        Start:
        @handle: Object path for the :ref:`org.freedesktop.impl.portal.Request` object representing this call
        @app_id: App ID of the application
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @start_uri: The URI to open
        @completion_uri: The URI whose navigation ends the flow
        @options: Vardict with optional further information
        @response: Numeric response
        @results: Vardict with the results of the call

        Runs a web sign-in flow.

        @app_id is derived by the frontend. An empty string means the frontend
        could not establish one. In that case, the backend must identify the
        application as unidentified and must not display an empty name or an
        application-supplied name.

        Supported keys in the @options vardict include:

        * ``activation_token`` (``s``)

          Passed through unchanged; the backend decides whether to use it.

        * ``session_mode`` (``s``)

          ``shared`` or ``ephemeral``, validated by the frontend.

        * ``timeout`` (``u``)

          Maximum duration in seconds, clamped by the frontend. The frontend
          enforces the deadline by calling ``Close()`` on @handle and returning
          a response to the application. The backend should also enforce the
          deadline and must close its window when the flow ends.

        * ``title`` (``s``)

          Untrusted application text, already length limited.

        * ``app_identity_level`` (``s``)

          Trust level of @app_id: ``sandboxed`` for an ID verified by a sandbox
          engine, ``host`` for an ID derived from a host process, and
          ``unidentified`` when the frontend could not establish an ID. The
          backend must display this distinction and use the supplied level.

        The frontend omits ``handle_token`` and unknown keys.

        The following results get returned via the @results vardict:

        * ``completion_uri`` (``s``)

          The complete, undecoded URI from the web engine, including query and
          fragment. Backends must return the original URI without
          reconstructing it. Present only when @response is ``0``. The frontend
          validates its parsed components against @completion_uri before
          returning it to the application. See
          :ref:`org.freedesktop.portal.experimental.WebAuthentication1.Start`
          for the rule.

          @completion_uri is an ``http`` or ``https`` URI with a host, or a
          private-use scheme redirect URI as described in :rfc:`8252` section
          7.1, such as ``com.example.app:/oauth2redirect``, which has no
          authority and is matched on its scheme and path. Backends must
          report matching navigations even if the engine rejects the scheme.

        * ``reason`` (``s``)

          An optional stable symbol explaining a non-zero @response, for
          instance ``timeout``, ``no_display``, ``no_engine``,
          ``user_cancelled``, ``session_terminated`` or
          ``credential_unavailable``. The frontend forwards this value
          unchanged to the application.
    -->
    <method name="Start">
      <arg type="o" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="s" name="start_uri" direction="in"/>
      <arg type="s" name="completion_uri" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In5" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>

    <property name="version" type="u" access="read"/>
  </interface>
</node>
