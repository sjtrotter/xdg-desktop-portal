<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <!--
      org.freedesktop.impl.portal.experimental.Certificate:
      @short_description: Backend for the portal for certificates on security tokens

      This backend interface drives the certificate chooser, the consent
      dialog and any PIN entry, and performs the private key operations
      against the token.

      The private key never crosses this interface, and neither does the PIN.
      The backend is told what the frontend already decided: the grant
      lifetime here is the lifetime the frontend allows, not the one the
      application asked for, and the identity level of ``app_id`` is stated
      explicitly so that the backend can show the user how much the name can
      be trusted.

      This is an **experimental** interface and can change or get removed
      without a version bump.
  -->
  <interface name="org.freedesktop.impl.portal.experimental.Certificate">
    <!--
        CreateSession:
        @handle: Object path for the :ref:`org.freedesktop.impl.portal.Request` object representing this call
        @session_handle: Object path for the :ref:`org.freedesktop.impl.portal.Session` object
        @app_id: App ID of the application
        @options: Vardict with optional further information
        @response: Numeric response
        @results: Vardict with the results of the call

        Creates an empty grant session. The @options vardict is currently
        unused, and the @results vardict is currently empty.
    -->
    <method name="CreateSession">
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In3" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>

    <!--
        AcquireCredential:
        @handle: Object path for the :ref:`org.freedesktop.impl.portal.Request` object representing this call
        @session_handle: Object path for the :ref:`org.freedesktop.impl.portal.Session` object
        @app_id: App ID of the application
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @options: Vardict with optional further information
        @response: Numeric response
        @results: Vardict with the results of the call

        Lets the user select a certificate and authorize its use.

        Supported keys in the @options vardict include:

        * ``purpose`` (``s``), ``certificate_filter`` (``a{sv}``),
          ``operation_policy`` (``a{sv}``), ``interaction_mode`` (``s``),
          ``activation_token`` (``s``) and ``reason`` (``s``)

          As on :ref:`org.freedesktop.portal.experimental.Certificate.AcquireCredential`.
          They have been validated by the frontend; an unknown value never
          reaches the backend.

          ``purpose`` and ``operation_policy`` are read together. A
          certificate matches ``client_auth``, ``signing`` or ``ssh`` only if
          its key will sign; ``email`` covers both halves of S/MIME and is
          matched by a certificate whose key usage permits
          ``digitalSignature`` **or** ``keyEncipherment``. A backend must
          offer a certificate that can only decrypt — a PIV "key management"
          certificate, ``keyEncipherment`` with no ``digitalSignature`` — for
          ``email`` only when ``operation_policy`` permits ``decrypt``, and
          must then report ``decrypt`` alone in ``permitted_operations``.

        * ``lifetime`` (``u``)

          The number of seconds the frontend has decided to allow. This is not
          the application's request: the ceiling has already been applied.

        * ``app_identity_level`` (``s``)

          How much the @app_id can be trusted: ``verified_sandboxed``,
          ``derived_host`` or ``unidentified``. The backend is expected to
          make the difference visible to the user.

        * ``allow_selection_memory`` (``b``)

          Whether the backend may offer the user the choice to reuse this
          certificate for this application next time. This is the effective
          value, not the application's request: it is true only if the
          application asked for it *and* ``app_identity_level`` is not
          ``unidentified``.

          A backend must not offer selection memory when this is false. The
          frontend will discard ``remember_selection`` in that case, so an
          offer made anyway is a promise to the user that nothing will keep.

        * ``preselect_certificate`` (``s``)

          A stable certificate identifier, remembered from an earlier grant.
          This preselects only: consent and PIN entry still happen.

        The following results get returned via the @results vardict:

        * ``certificate_der`` (``ay``), ``chain_der`` (``aay``),
          ``chain_status`` (``s``), ``token_display`` (``a{sv}``),
          ``key_type`` (``s``), ``key_size`` (``u``), ``key_curve`` (``s``),
          ``supported_mechanisms`` (``as``), ``permitted_operations``
          (``as``), ``may_prompt_later`` (``b``)

          As on the public interface. The frontend intersects
          ``supported_mechanisms`` and ``permitted_operations`` with what it
          allows; a backend that returns more than it may does not get more.

        * ``certificate_id`` (``s``)

          A stable identifier for the selected certificate. The frontend
          decides whether to store it for selection memory.

        * ``remember_selection`` (``b``)

          Whether the user asked for this selection to be remembered. Only
          meaningful if ``allow_selection_memory`` was true; the frontend
          ignores it otherwise.
    -->
    <method name="AcquireCredential">
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In4" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>

    <!--
        Sign:
        @handle: Object path for the :ref:`org.freedesktop.impl.portal.Request` object representing this call
        @session_handle: Object path for the :ref:`org.freedesktop.impl.portal.Session` object
        @app_id: App ID of the application
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @options: Vardict with optional further information
        @response: Numeric response
        @results: Vardict with the results of the call

        Signs data with the key of the granted certificate.

        Supported keys in the @options vardict are ``mechanism`` (``s``),
        ``parameters`` (``a{sv}``) and ``data`` (``ay``), as on the public
        interface. The frontend has already checked that the grant permits the
        operation and the mechanism; the backend still validates the
        parameters against the mechanism and the key, which is the only place
        the modulus size is known.

        ``data`` is always a digest, never a message. The frontend requires a
        ``hash`` parameter naming one of ``SHA1``, ``SHA224``, ``SHA256``,
        ``SHA384`` or ``SHA512``, and refuses a ``data`` whose length is not
        that digest's length. A backend must not accept a ``data`` of some
        other length, and must not offer a mechanism that signs a message.

        For ``ECDSA``, ``parameters`` may carry ``signature_encoding``
        (``s``), which the frontend validates as ``raw`` or ``der``. ``raw``
        is the default and means r and s concatenated, each padded to the byte
        length of the curve order — what PKCS#11 produces. ``der`` means the
        ``Ecdsa-Sig-Value`` SEQUENCE of RFC 3279. A backend that implements
        ECDSA must implement both, and must default to ``raw``.

        For ``RSA_PSS``, ``parameters`` may carry ``mgf`` (``s``) and
        ``salt_length`` (``u``), which the frontend forwards without
        interpreting: neither can be checked without the modulus size. ``mgf``
        names a mask generation function and is spelled ``MGF1-<hash>``, for
        example ``MGF1-SHA256``; plain ``MGF1`` means MGF1 over ``hash``. A
        backend must accept that vocabulary and no other, and in the absence
        of either key must default to MGF1 over ``hash`` and to a salt of that
        digest's length.

        The @results vardict carries ``signature`` (``ay``).
    -->
    <method name="Sign">
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In4" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>

    <!--
        Decrypt:
        @handle: Object path for the :ref:`org.freedesktop.impl.portal.Request` object representing this call
        @session_handle: Object path for the :ref:`org.freedesktop.impl.portal.Session` object
        @app_id: App ID of the application
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @options: Vardict with optional further information
        @response: Numeric response
        @results: Vardict with the results of the call

        Decrypts data with the key of the granted certificate.

        The @options vardict takes the same keys as
        :ref:`org.freedesktop.impl.portal.experimental.Certificate.Sign`, with
        ``ciphertext`` (``ay``) in place of ``data``. The @results vardict
        carries ``plaintext`` (``ay``).

        ``mechanism`` is always ``RSA_OAEP``: the frontend refuses every other
        value for this method, and in particular refuses ``RSA_PKCS1_V1_5``,
        because a v1.5 decryption whose outcome the caller can observe is a
        Bleichenbacher oracle over the token's private key. A backend must not
        implement v1.5 decryption behind some other mechanism name either.

        The frontend has checked that ``parameters`` names a ``hash`` it
        knows, that ``mgf1_hash``, if present, names the same one, and that
        ``label``, if present, is at most 256 bytes. The backend still checks
        the parameters against the key, in particular that the ciphertext is
        exactly one modulus long.
    -->
    <method name="Decrypt">
      <arg type="o" name="handle" direction="in"/>
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In4" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>

    <!--
        GetCapabilities:
        @app_id: App ID of the application
        @options: Vardict with optional further information
        @capabilities: Vardict describing what the backend can do

        Reports what the backend can do. No window is shown.

        The @capabilities vardict contains ``purposes`` (``as``),
        ``operations`` (``as``), ``mechanisms`` (``as``),
        ``protected_authentication_path`` (``b``) and ``has_display`` (``b``).
        The frontend intersects this with its own policy before answering the
        application, and adds the keys that are its own to decide.
    -->
    <method name="GetCapabilities">
      <arg type="s" name="app_id" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
      <arg type="a{sv}" name="capabilities" direction="out"/>
    </method>

    <!--
        TokenAdded:
        @token: Vardict saying that a token is present

        Emitted when a security token becomes available.

        The frontend re-emits this as
        :ref:`org.freedesktop.portal.experimental.Certificate::TokenAdded`,
        which is a broadcast to every client on the session bus. It therefore
        forwards only:

        * ``token_id`` (``s``)

          An opaque, stable identifier for the token. It must be stable for as
          long as the token is present, must match the ``token_id`` of the
          matching ``TokenRemoved``, and must not be derivable from the card:
          a serial number, or a hash of one that another party can recompute,
          is a correlation handle across applications and is not acceptable
          here.

        * ``protected_authentication_path`` (``b``)

          Whether the PIN for this token is entered on the reader.

        Every other key is dropped. A backend must not put the token label,
        manufacturer, model or reader name on this signal even though the
        frontend would discard them: those belong in ``token_display`` in the
        :ref:`org.freedesktop.impl.portal.experimental.Certificate.AcquireCredential`
        results, which reach only the application that was granted a
        credential.
    -->
    <signal name="TokenAdded">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
      <arg type="a{sv}" name="token"/>
    </signal>

    <!--
        TokenRemoved:
        @token: Vardict saying that a token is gone

        Emitted when a security token goes away. The @token vardict has the
        same shape, and the same restrictions, as on
        :ref:`org.freedesktop.impl.portal.experimental.Certificate::TokenAdded`.
    -->
    <signal name="TokenRemoved">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
      <arg type="a{sv}" name="token"/>
    </signal>

    <!--
        SessionInvalidated:
        @session_handle: Object path of the affected session
        @reason: Why the session can no longer be used

        Emitted when the backend can no longer honour a grant.

        The frontend turns this into
        :ref:`org.freedesktop.portal.experimental.Certificate::GrantInvalidated`
        and closes the session. It forwards @reason verbatim, so the
        vocabulary here is the public one and not a smaller list: ``released``,
        ``expired``, ``token_removed``, ``owner_gone``, ``policy``,
        ``service_shutdown``, ``backend_gone`` or ``error``. A backend that
        invents a value hands it straight to applications, which is why it
        should not.
    -->
    <signal name="SessionInvalidated">
      <arg type="o" name="session_handle"/>
      <arg type="s" name="reason"/>
    </signal>

    <property name="version" type="u" access="read"/>
  </interface>
</node>
