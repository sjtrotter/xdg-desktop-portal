<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <!--
      org.freedesktop.portal.experimental.Certificate:
      @short_description: Portal for using certificates and keys held on a security token

      This interface lets sandboxed applications use a certificate and its
      private key without ever seeing the private key, and without talking to
      PKCS#11 modules, card readers or PIN entry themselves. The application
      asks for a certificate that fits a purpose, the user picks one and
      authorizes its use, and the application can then ask for signatures made
      with the matching key.

      The token is usually a smart card reached through a PKCS#11 module — a
      PIV card, a national eID card, a hardware security key — but it may
      equally be a TPM or a software key store. This interface names the
      credential rather than the hardware: what crosses it is a certificate
      and operations on the key behind it, never a PKCS#11 object, session or
      token, and never a card reader.

      The private key never crosses this interface. Neither does the PIN: the
      backend is responsible for any PIN entry, and no key material, PIN value
      or PIN source ever appears in an argument or a result.

      A grant is a session. :ref:`org.freedesktop.portal.experimental.Certificate.CreateSession`
      creates an empty one,
      :ref:`org.freedesktop.portal.experimental.Certificate.AcquireCredential`
      fills it in with a certificate the user chose, and
      :ref:`org.freedesktop.portal.Session::Close` (or
      :ref:`org.freedesktop.portal.experimental.Certificate.ReleaseGrant`) ends
      it. A grant is bound to the D-Bus connection that created it, to the
      token that backs it, and to the operations and mechanisms the frontend
      allowed; a grant always has an expiry.

      This is an **experimental** interface. It is not exported unless
      ``XDG_DESKTOP_PORTAL_ENABLE_EXPERIMENTAL`` contains ``certificate``, and
      it can change or get removed without a version bump.

      This documentation describes version 1 of this interface.
  -->
  <interface name="org.freedesktop.portal.experimental.Certificate">
    <!--
        CreateSession:
        @options: Vardict with optional further information
        @handle: Object path for the :ref:`org.freedesktop.portal.Request` object representing this call

        Creates a grant session. The session starts out empty; call
        :ref:`org.freedesktop.portal.experimental.Certificate.AcquireCredential`
        on it to have the user select a certificate and authorize its use.

        Supported keys in the @options vardict include:

        * ``handle_token`` (``s``)

          A string that will be used as the last element of the @handle. Must be a valid
          object path element. See the :ref:`org.freedesktop.portal.Request` documentation for
          more information about the @handle.

        * ``session_handle_token`` (``s``)

          A string that will be used as the last element of the session handle. Must be a
          valid object path element. See the :ref:`org.freedesktop.portal.Session`
          documentation for more information about the session handle.

        The following results get returned via the :ref:`org.freedesktop.portal.Request::Response` signal:

        * ``session_handle`` (``o``)

          The session handle. An object path for the
          :ref:`org.freedesktop.portal.Session` object representing the created
          session.
    -->
    <method name="CreateSession">
      <annotation name="org.qtproject.QtDBus.QtTypeName.In0" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="o" name="handle" direction="out"/>
    </method>

    <!--
        AcquireCredential:
        @session_handle: Object path for the :ref:`org.freedesktop.portal.Session` object
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @options: Vardict with optional further information
        @handle: Object path for the :ref:`org.freedesktop.portal.Request` object representing this call

        Asks the user to select a certificate and authorize its use for the
        given purpose. On success the session named by @session_handle becomes
        a grant, and :ref:`org.freedesktop.portal.experimental.Certificate.Sign`
        and :ref:`org.freedesktop.portal.experimental.Certificate.Decrypt` can
        be called on it.

        Supported keys in the @options vardict include:

        * ``handle_token`` (``s``)

          A string that will be used as the last element of the @handle. Must be a valid
          object path element. See the :ref:`org.freedesktop.portal.Request` documentation for
          more information about the @handle.

        * ``activation_token`` (``s``)

          A token that can be used to activate the chooser window, see
          :doc:`window-identifiers`.

        * ``purpose`` (``s``)

          Required. What the credential is for. One of ``client_auth``,
          ``signing``, ``email`` or ``ssh``. There is deliberately no value
          meaning "anything": the purpose selects the consent wording and
          bounds the operations and mechanisms the grant may be used for.

          ``client_auth``, ``signing`` and ``ssh`` are signing purposes: a
          certificate matches one of them only if its key will sign. ``email``
          is not one. S/MIME splits mail between a signing certificate and a
          decryption certificate, and on a smart card those are separate keys:
          a PIV "key management" certificate carries ``keyEncipherment``
          without ``digitalSignature``, and the key behind it will decrypt and
          never sign. A certificate therefore matches ``email`` when its
          extended key usage permits ``emailProtection`` — or it carries no
          extended key usage at all — and its key usage permits **either**
          ``digitalSignature`` **or** ``keyEncipherment``.

          A certificate that can only decrypt is offered for ``email`` only
          when ``operation_policy`` permits ``decrypt``, and the
          ``permitted_operations`` of the resulting grant then holds
          ``decrypt`` alone. An application asking for ``email`` in order to
          sign a message should leave ``operation_policy`` at its default,
          which is ``sign`` only, and will not be offered such a certificate.

        * ``certificate_filter`` (``a{sv}``)

          Narrows the certificates offered to the user. All keys are optional
          and are combined with a logical AND. Supported keys are ``issuers``
          (``aay``, DER encoded issuer distinguished names), ``key_usage``
          (``as``), ``eku`` (``as``, extended key usage OIDs),
          ``key_algorithms`` (``as``), ``token_label`` (``s``) and
          ``piv_slot`` (``s``, one of ``authentication``, ``signature``,
          ``key_management`` or ``card_authentication``).

          A filter narrows what is offered; it never widens it, and it is not
          a security boundary.

        * ``operation_policy`` (``a{sv}``)

          The operations the application is asking for, as ``sign`` (``b``)
          and ``decrypt`` (``b``). Defaults to ``{'sign': true}``.

        * ``requested_lifetime`` (``u``)

          How long, in seconds, the application would like the grant to live.
          This is a ceiling request, not a floor: the portal may grant less and
          never grants more than its own maximum, which is advertised as
          ``max_grant_lifetime`` by
          :ref:`org.freedesktop.portal.experimental.Certificate.GetCapabilities`.

        * ``interaction_mode`` (``s``)

          One of ``required`` (always prompt), ``allowed`` (prompt if needed,
          the default) or ``forbidden`` (never prompt; a request that would
          need a chooser or a PIN fails instead).

        * ``allow_selection_memory`` (``b``)

          Whether the user may be offered the choice to reuse this certificate
          for this application next time. This only ever preselects: it never
          skips consent and never skips a PIN. It is ignored for applications
          whose identity could not be verified.

        * ``reason`` (``s``)

          A string that can be shown in the dialog to explain why the
          credential is needed. This is application-supplied text; the backend
          must present it as such and never in the position where it shows the
          identity of the application.

        The following results get returned via the :ref:`org.freedesktop.portal.Request::Response` signal:

        * ``grant_id`` (``s``)

          An opaque identifier naming this grant in diagnostics and in the
          :ref:`org.freedesktop.portal.experimental.Certificate::GrantInvalidated`
          signal. It is not a capability; the session handle is.

        * ``certificate_der`` (``ay``)

          The selected leaf certificate, DER encoded.

        * ``chain_der`` (``aay``)

          Ordered intermediate certificates, best effort.

        * ``chain_status`` (``s``)

          How complete ``chain_der`` is: ``complete``, ``partial`` or
          ``leaf_only``. This describes completeness, not trust.

        * ``token_display`` (``a{sv}``)

          Token and reader identity for display only.

        * ``key_type`` (``s``)

          ``RSA`` or ``EC``.

        * ``key_size`` (``u``)

          Modulus size in bits, or curve size.

        * ``key_curve`` (``s``)

          The curve name, for EC keys.

        * ``supported_mechanisms`` (``as``)

          The mechanisms this grant may be used with. This is the portal's
          allow list intersected with what the backend reported.

        * ``permitted_operations`` (``as``)

          A subset of ``sign`` and ``decrypt``.

        * ``expires_at`` (``t``)

          When the grant expires, in seconds since the Unix epoch. This can be
          sooner than ``requested_lifetime`` asked for.

        * ``may_prompt_later`` (``b``)

          Whether a later ``Sign`` or ``Decrypt`` on this grant may show a
          window.
    -->
    <method name="AcquireCredential">
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In2" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="o" name="handle" direction="out"/>
    </method>

    <!--
        Sign:
        @session_handle: Object path for the :ref:`org.freedesktop.portal.Session` object
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @options: Vardict with optional further information
        @handle: Object path for the :ref:`org.freedesktop.portal.Request` object representing this call

        Signs data with the key of the certificate this grant is for.

        Supported keys in the @options vardict include:

        * ``handle_token`` (``s``)

          A string that will be used as the last element of the @handle. Must be a valid
          object path element. See the :ref:`org.freedesktop.portal.Request` documentation for
          more information about the @handle.

        * ``operation_id`` (``s``)

          An application-chosen string, returned unchanged in the results, so
          that a result and a diagnostic can be correlated without correlating
          them by content.

        * ``mechanism`` (``s``)

          Required. One of the names the grant reported in
          ``supported_mechanisms``, and one that can sign: ``RSA_PKCS1_V1_5``,
          ``RSA_PSS`` or ``ECDSA``. ``RSA_OAEP`` is for
          :ref:`org.freedesktop.portal.experimental.Certificate.Decrypt` only.

        * ``parameters`` (``a{sv}``)

          Whatever the mechanism needs. Validated against the mechanism and
          the key rather than passed through. Every signature mechanism here
          takes:

          * ``hash`` (``s``)

            Required. Which digest ``data`` is. One of ``SHA1``, ``SHA224``,
            ``SHA256``, ``SHA384`` or ``SHA512``; the ``SHA-256`` spelling is
            accepted too.

          ``RSA_PSS`` additionally takes:

          * ``mgf`` (``s``)

            The mask generation function, spelled ``MGF1-<hash>`` — for
            example ``MGF1-SHA256``. Plain ``MGF1`` means MGF1 over ``hash``,
            which is also the default when the key is absent. PKCS#1 allows
            MGF1 to use a different hash than the signature; nothing here
            needs that.

          * ``salt_length`` (``u``)

            The salt length in bytes, defaulting to the digest's length. The
            backend checks it against the modulus, which is the only place the
            modulus size is known.

          ``ECDSA`` additionally takes:

          * ``signature_encoding`` (``s``)

            ``raw`` (the default): the signature is r and s concatenated,
            each padded to the byte length of the curve order, which is what
            PKCS#11 produces and what most callers want. ``der``: the
            signature is the ``Ecdsa-Sig-Value`` SEQUENCE of RFC 3279.

        * ``data`` (``ay``)

          Required. The digest of the message under the ``hash`` named in
          ``parameters``, and never the message itself. Its length must be
          exactly that digest's length; a request whose ``data`` is a
          different length is refused.

          What that rule buys is worth stating exactly, because it is less
          than it looks. The caller cannot obtain a signature over bytes it
          did not hash itself, and it cannot have an arbitrary blob wrapped
          in raw PKCS#1 v1.5 padding and signed — a structure whose meaning
          the caller chose cannot be handed over whole. It remains a signing
          capability over any message the caller cares to hash, as every
          signing interface is. What bounds it is the grant: its ``purpose``,
          its expiry, its ``permitted_operations``, and the consent the user
          gave for them.

        The following results get returned via the :ref:`org.freedesktop.portal.Request::Response` signal:

        * ``signature`` (``ay``)

          The signature.

        * ``operation_id`` (``s``)

          The ``operation_id`` from the options, unchanged.
    -->
    <method name="Sign">
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In2" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="o" name="handle" direction="out"/>
    </method>

    <!--
        Decrypt:
        @session_handle: Object path for the :ref:`org.freedesktop.portal.Session` object
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @options: Vardict with optional further information
        @handle: Object path for the :ref:`org.freedesktop.portal.Request` object representing this call

        Decrypts data with the key of the certificate this grant is for. Only
        available if the grant reported ``decrypt`` in
        ``permitted_operations``.

        The @options vardict takes the same keys as
        :ref:`org.freedesktop.portal.experimental.Certificate.Sign`, with
        ``ciphertext`` (``ay``) in place of ``data``.

        ``RSA_OAEP`` is the only ``mechanism`` this portal will decrypt with.
        ``RSA_PKCS1_V1_5`` is a signature mechanism here and nothing else: a
        v1.5 decryption tells the caller whether the padding was well formed,
        which is a Bleichenbacher oracle over the private key on the token,
        and one grant would buy an unbounded number of queries.

        ``RSA_OAEP`` takes these ``parameters``:

        * ``hash`` (``s``)

          Required. One of ``SHA1``, ``SHA224``, ``SHA256``, ``SHA384`` or
          ``SHA512``; the ``SHA-256`` spelling is accepted too.

        * ``mgf1_hash`` (``s``)

          Optional, and must name the same hash as ``hash``. PKCS#1 allows
          the two to differ; this interface does not.

        * ``label`` (``ay``)

          Optional OAEP label, at most 256 bytes. It is a domain separator,
          not a payload.

        The following results get returned via the :ref:`org.freedesktop.portal.Request::Response` signal:

        * ``plaintext`` (``ay``)

          The decrypted data.

        * ``operation_id`` (``s``)

          The ``operation_id`` from the options, unchanged.
    -->
    <method name="Decrypt">
      <arg type="o" name="session_handle" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In2" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="o" name="handle" direction="out"/>
    </method>

    <!--
        RenewGrant:
        @session_handle: Object path for the :ref:`org.freedesktop.portal.Session` object
        @options: Vardict with optional further information
        @expires_at: The new expiry, in seconds since the Unix epoch

        Extends the lifetime of a grant. This is decided entirely in the
        portal frontend; the backend is not asked, no window is shown, and the
        set of permitted operations and mechanisms never grows. Renewal fails
        if the grant is gone, if the token that backs it went away, or if the
        caller is not the connection that owns the grant.

        **Renewal is bounded in total, not only per renewal.** The consent the
        user gave at
        :ref:`org.freedesktop.portal.experimental.Certificate.AcquireCredential`
        carries an absolute deadline — ``max_grant_total_lifetime`` seconds
        after the moment it was given, reported by
        :ref:`org.freedesktop.portal.experimental.Certificate.GetCapabilities`
        — which renewal never moves. A renewal made before the deadline is
        clamped to it; a renewal made after it fails with
        ``org.freedesktop.portal.Error.NotAllowed``, and the only way on is a
        fresh ``AcquireCredential``, which asks the user again. Without this a
        caller renewing every few minutes would keep one consent alive
        indefinitely, which is not what a consent duration means.

        The @options vardict currently takes:

        * ``requested_lifetime`` (``u``)

          How much longer, in seconds, the application would like the grant to
          live. As with
          :ref:`org.freedesktop.portal.experimental.Certificate.AcquireCredential`
          this is a ceiling request, and it is clamped to the consent's
          absolute deadline as well as to ``max_grant_lifetime``.
    -->
    <method name="RenewGrant">
      <arg type="o" name="session_handle" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="t" name="expires_at" direction="out"/>
    </method>

    <!--
        ReleaseGrant:
        @session_handle: Object path for the :ref:`org.freedesktop.portal.Session` object

        Ends a grant. This is equivalent to calling
        :ref:`org.freedesktop.portal.Session.Close` on the session, and is
        provided because "release the grant" is what the calling code means.
        Releasing a grant that is already gone succeeds.
    -->
    <method name="ReleaseGrant">
      <arg type="o" name="session_handle" direction="in"/>
    </method>

    <!--
        GetCapabilities:
        @options: Vardict with optional further information
        @capabilities: Vardict describing what this portal and its backend can do

        Reports what this portal can do, so that an application can adapt
        without provoking a dialog. No window is shown and nothing is
        authorized by this call.

        The @options vardict is currently unused.

        The @capabilities vardict contains:

        * ``purposes`` (``as``)

          The purposes this portal accepts.

        * ``operations`` (``as``)

          A subset of ``sign`` and ``decrypt``.

        * ``mechanisms`` (``as``)

          The signature and decryption mechanisms this portal allows.

        * ``selection_memory`` (``b``)

          Whether the portal can remember a certificate selection.

        * ``protected_authentication_path`` (``b``)

          Whether the backend can use a PIN pad on the reader instead of an
          on-screen PIN entry.

        * ``max_grant_lifetime`` (``u``)

          The longest grant lifetime, in seconds, this portal will hand out.

        * ``max_grant_total_lifetime`` (``u``)

          How long one consent can be kept alive by renewal, in seconds,
          counted from the moment
          :ref:`org.freedesktop.portal.experimental.Certificate.AcquireCredential`
          succeeded. Once it has passed,
          :ref:`org.freedesktop.portal.experimental.Certificate.RenewGrant`
          fails and only a fresh acquisition, with its own consent, will do.
    -->
    <method name="GetCapabilities">
      <annotation name="org.qtproject.QtDBus.QtTypeName.In0" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
      <arg type="a{sv}" name="capabilities" direction="out"/>
    </method>

    <!--
        TokenAdded:
        @token: Vardict saying that a token is present

        Emitted when a security token becomes available.

        This signal is a broadcast: it is delivered to every client that
        subscribes to it, before anything has been consented to. It therefore
        carries no human-identifying data. The @token vardict contains:

        * ``token_id`` (``s``)

          An opaque, stable identifier for the token, for correlating an
          ``added`` with the matching ``removed``. It is not a hardware
          identifier and cannot be used to look a token up anywhere else.

        * ``protected_authentication_path`` (``b``)

          Whether the PIN for this token is entered on the reader.

        The token label, manufacturer, model and reader name are deliberately
        not here: a token label is routinely the cardholder's name or an
        employee number. The full ``token_display`` vardict is returned by
        :ref:`org.freedesktop.portal.experimental.Certificate.AcquireCredential`,
        so only an application that was granted a credential sees it.

        Open item: the signal is still broadcast to every subscriber rather
        than only to applications that hold a session or a stored permission
        for this portal. Per-recipient delivery needs directed signals, which
        the portal frontend has no machinery for yet.
    -->
    <signal name="TokenAdded">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
      <arg type="a{sv}" name="token"/>
    </signal>

    <!--
        TokenRemoved:
        @token: Vardict saying that a token is gone

        Emitted when a security token goes away. The @token vardict has the
        same shape, and the same restrictions, as on
        :ref:`org.freedesktop.portal.experimental.Certificate::TokenAdded`.
    -->
    <signal name="TokenRemoved">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
      <arg type="a{sv}" name="token"/>
    </signal>

    <!--
        GrantInvalidated:
        @session_handle: Object path of the session whose grant is gone
        @reason: Why the grant is gone

        Emitted when a grant stops being usable before it was released. The
        session is closed as well; this signal exists to say why.

        @reason is one of ``released``, ``expired``, ``token_removed``,
        ``owner_gone``, ``policy``, ``service_shutdown``, ``backend_gone`` or
        ``error``. Consumers must tolerate values they do not know.
    -->
    <signal name="GrantInvalidated">
      <arg type="o" name="session_handle"/>
      <arg type="s" name="reason"/>
    </signal>

    <property name="version" type="u" access="read"/>
  </interface>
</node>
